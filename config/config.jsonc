{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logos/blackarch.txt",
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 10 }
  },
  "modules": [
    {
      "type": "title",
      "keyColor": "green"
    },
    "separator",
    { "type": "os", "key": "OS", "keyColor": "green" },
    { "type": "kernel", "key": "Kernel", "keyColor": "green" },
    { "type": "uptime", "key": "Uptime", "keyColor": "green" },
    { "type": "packages", "key": "Packages", "keyColor": "green" },
    { "type": "shell", "key": "Shell", "keyColor": "green" },
    { "type": "command", "key": "Terminal", "keyColor": "green", "text": "echo Termux" },
    "break",
    { "type": "cpu", "key": "CPU", "keyColor": "cyan" },
    { "type": "gpu", "key": "GPU", "keyColor": "cyan", "format": "{name}" },
    { "type": "memory", "key": "RAM", "keyColor": "cyan" },
    { "type": "disk", "key": "Disk", "keyColor": "cyan", "folders": "/storage/emulated" },
    "break",
    { "type": "localip", "key": "IP", "keyColor": "yellow", "compact": true },
    { "type": "colors", "key": "Colors", "keyColor": "yellow" }
  ]
}
